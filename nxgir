#!/bin/sh
# Launcher for scripts/nxgir-cli.py. Works when called through a symlink too.
src="$0"
while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root="$(cd -P "$(dirname "$src")" && pwd)"
exec python3 "$root/scripts/nxgir-cli.py" "$@"
